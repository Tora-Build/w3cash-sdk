# Copy to .env and fill in. (.env is git-ignored; this template is committed.)
#
# The compiler endpoint is FREE in phase-1 and reads only PORT. Everything below
# is reserved for the x402 payment layer (phase-2) and is intentionally UNUSED
# today — leave these blank in phase-1. Do NOT paste live credentials until the
# x402 phase is actually wired, and inject them via the host's secret store
# (e.g. `wrangler secret put`), never commit real values to a repo file.

# --- x402 payment credentials (phase-2; leave blank in phase-1) ---
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- x402 settlement config (phase-2) ---
PAY_TO_ADDRESS=
# x402 settlement chain (CAIP-2). X Layer testnet is eip155:1952 (mainnet:
# eip155:196) — verified on-chain. This is the PAYMENT chain and intentionally
# differs from the intent EXECUTION chain, hard-targeted to Base Sepolia (84532).
NETWORK=eip155:1952

# x402 toggle. Leave unset/false for a FREE endpoint (phase-1). Set "true" (with
# the OKX creds + PAY_TO_ADDRESS + NETWORK above) to require x402 pay-per-call.
X402_ENABLED=false
# X402_PRICE=$0.01

# --- Server ---
PORT=4000

# --- demo / proof scripts (optional; NOT needed to run the server) ---
# Only the scripts in scripts/ read these; the HTTP server never does. Leave blank
# unless you are running the demo kit, and inject secrets via the host's secret
# store rather than committing them.
#
# execute-demo.ts (pnpm demo) REQUIRES a funded key — a little Base Sepolia ETH for
# gas plus test USDC — to actually move funds on-chain:
RELAYER_PRIVATE_KEY=
# Optional RPC override for decode-proof.ts (pnpm proof) and execute-demo.ts
# (default: the consistent https://base-sepolia-rpc.publicnode.com):
BASE_SEPOLIA_RPC=
# Optional Across API base for bridge quotes / autoQuote (default:
# https://testnet.across.to/api):
ACROSS_API_URL=
# Optional gate for execute-demo.ts — a unix timestamp. A PAST value executes
# immediately (proving the condition path); a FUTURE value pauses on-chain:
WAIT_UNTIL=
