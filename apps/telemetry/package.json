{
  "name": "@w3cash/telemetry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "W3Cash telemetry worker — indexes on-chain intent events + serves status/reliability (Cloudflare Worker + D1).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute w3cash-telemetry --file=./schema.sql"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "wrangler": "^3.80.0"
  }
}
